# Copy to .env.local for local dev; set the same keys as host secrets in production.
# Validated at runtime by src/lib/env.ts (zod).

# From your GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 32+ chars each, different values, different per environment.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
MCP_TOKEN_SECRET=

# Must exactly match the GitHub OAuth App callback origin.
# Local: http://localhost:3000   Prod: https://<your-domain>
APP_URL=http://localhost:3000
